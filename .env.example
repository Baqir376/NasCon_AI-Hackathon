# ==========================================================
# NaSCon'26 Personal Morning Paper — Environment Configuration
# ==========================================================

# Database Connection (SQLite local file by default)
DATABASE_URL="file:./dev.db"

# Session Security Secret (Must be a secure 32+ character random string in production)
SESSION_SECRET="nascon26-morning-paper-development-secret-key-change-in-production"

# LLM Provider Configuration
# Supported providers: gemini | groq | offline
LLM_PROVIDER="gemini"

# Google Gemini API Configuration (Google AI Studio)
# Free tier: 15 RPM, 1,500 RPD (no credit card needed at https://aistudio.google.com)
# When empty or omitted, the application automatically falls back to deterministic offline extraction.
GEMINI_API_KEY=""
GEMINI_MODEL_ID="gemini-2.5-flash"

# Optional Alternative Provider: Groq API (https://console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL_ID="llama-3.1-8b-instant"

# Application Base URL (used for internal SSR and PDF rendering callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Features
ENABLE_SERENDIPITY="true"
LOG_LEVEL="info"
